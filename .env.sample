# Copy this file to .env and fill in the key. Never commit .env or paste the key into chat.
ANTHROPIC_API_KEY=

# Optional: the model that answers questions. Defaults to claude-opus-5-5.
# SITE_ANSWERS_MODEL=claude-opus-5-5

# Optional: TypeSafe key for the Jev check on unclear "visitor looks stuck" signals.
# Without it, unclear signals are recorded for the owner but no help note is shown.
TYPESAFE_API_KEY=
